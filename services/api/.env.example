# SQLite is for local development only. PostgreSQL is required in production.
DATABASE_URL=sqlite:///./ordermesh.db
# In production, configure the runtime PostgreSQL URL explicitly.
# Use the migration-only identity for Alembic; never use it as the API runtime role.
MIGRATION_DATABASE_URL=
# If runtime and migration PostgreSQL endpoints differ (for example, pooler vs direct),
# set both target IDs to the same non-secret environment/project label.
DATABASE_TARGET_ID=
MIGRATION_DATABASE_TARGET_ID=
APP_ENV=development
APP_ORIGIN=http://localhost:3000
ALLOW_REGISTRATION=true
SESSION_HOURS=12
# Absolute path to a licensed Sinhala-capable TrueType font; optional for Latin invoices.
# Optional override; bundled Noto fonts support Sinhala/English/Tamil by default.
INVOICE_FONT_PATH=
# Default is offline and makes no external AI calls.
AI_PROVIDER=local
# Optional: set AI_PROVIDER=openai only after supplying both values and approving data transfer.
OPENAI_API_KEY=
OPENAI_MODEL=
# Google OAuth (server-side only). The redirect URI must exactly match the Web
# application redirect URI configured in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# PostgreSQL connection pool; SQLite local development keeps its SQLite pooling.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Meta Cloud API webhook secrets (server-side only; generate unique random values).
WHATSAPP_VERIFY_TOKEN=
# Embedded Signup identifiers; configure in the API environment.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
# Single-number Cloud API test sender; keep access token in this API-only env.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ALLOWED_TEST_RECIPIENTS=
WHATSAPP_TEST_MODE=true
# Supabase/PostgreSQL example, not a configured integration:
# DATABASE_URL=postgresql+psycopg://ordermesh_app:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require

# PayHere credentials are server-side only. Use a public HTTPS callback URL.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=

# Stable Fernet key for encrypted Meta connections; keep private and back it up.
META_CONNECTION_ENCRYPTION_KEY=
# Public HTTPS webhook ending /webhooks/whatsapp; verify it in Meta.
WHATSAPP_PUBLIC_CALLBACK_URL=

# WhatsApp voice notes: original-language speech-to-text, using OPENAI_API_KEY.
VOICE_TRANSCRIPTION_ENABLED=true
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Images use the existing text model unless a vision-capable override is set.
IMAGE_EXTRACTION_ENABLED=true
OPENAI_VISION_MODEL=
