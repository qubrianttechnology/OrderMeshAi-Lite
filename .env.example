# Docker Compose only. Fill both passwords with independently generated random hex strings.
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
APP_ENV=development
APP_ORIGIN=http://localhost:3000
ALLOW_REGISTRATION=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Optional non-secret labels when runtime and migration PostgreSQL endpoints differ.
DATABASE_TARGET_ID=
MIGRATION_DATABASE_TARGET_ID=
# AI is disabled in favor of local rules unless explicitly enabled.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional server-side Meta webhook secrets for the API container.
WHATSAPP_VERIFY_TOKEN=
# Embedded Signup identifiers; configure in the API environment.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ALLOWED_TEST_RECIPIENTS=
WHATSAPP_TEST_MODE=true
# Internal API URL used at Next.js build time.
API_BASE_URL=http://api:8000

# PayHere credentials are server-side only. Use a public HTTPS callback URL.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=

# Stable Fernet key for encrypted Meta connections; keep private and back it up.
META_CONNECTION_ENCRYPTION_KEY=
# Public HTTPS webhook ending /webhooks/whatsapp; verify it in Meta.
WHATSAPP_PUBLIC_CALLBACK_URL=

# WhatsApp voice notes: original-language speech-to-text, using OPENAI_API_KEY.
VOICE_TRANSCRIPTION_ENABLED=true
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Images use the existing text model unless a vision-capable override is set.
IMAGE_EXTRACTION_ENABLED=true
OPENAI_VISION_MODEL=
